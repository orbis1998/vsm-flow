# Copier vers .env en local. Sur Vercel : Settings → Environment Variables
# (Production + Preview). Ne jamais committer les vraies valeurs.

# Obligatoire — pooler IPv4 :6543 (pas db.*.supabase.co:5432)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Optionnel si DATABASE_URL est complet
PGHOST=aws-1-eu-west-1.pooler.supabase.com
PGPORT=6543
PGUSER=postgres.PROJECT_REF
PGDATABASE=postgres
PGPASSWORD=

# Obligatoire pour les notifications push navigateur
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Local seulement (scripts/wipe-ops.mjs) — inutile sur Vercel
# ADMIN_PASSWORD=
