# Copy to .env — never commit real secrets.

# Transaction pooler (IPv4). Do not use db.*.supabase.co from this Windows machine (IPv6-only).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
PGHOST=aws-1-eu-west-1.pooler.supabase.com
PGPORT=6543
PGUSER=postgres.PROJECT_REF
PGDATABASE=postgres
PGPASSWORD=
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Seed opérationnel (après les migrations) : npm run db:wipe
# Compter les tables : npm run db:tables
ADMIN_PASSWORD=

# Web Push (VAPID) — générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
